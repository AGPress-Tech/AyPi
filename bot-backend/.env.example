# Copiare questo file come .env accanto all'eseguibile AyPi Backend,
# oppure indicarne il percorso con AYPI_BOT_ENV.
BOT_TOKEN=

# Il bot usa automaticamente l'URL del backend avviato nello stesso processo.
# Impostare questa voce solo per sviluppo o diagnostica.
# AYPI_BACKEND_URL=http://192.168.1.240:3000

# I dati Telegram dedicati (utenti, ruoli, messaggi e dizionario) continuano
# per compatibilità a usare la cartella storica AyPiZoea.
# AYPI_BOT_DATA_DIR=\\Dl360\pubbliche\TECH\AyPi\AGPRESS\AyPiZoea

# Cache tecnica locale usata per adattare le funzioni storiche alle API AyPi.
# AYPI_BOT_CACHE_DIR=C:\ProgramData\AyPi\TelegramBot\cache

# Configurazione meteo storica del bot Telegram (opzionale).
WEATHERAPI_KEY=
WEATHER_ALLOW_INSECURE_TLS=0

# Timeout delle richieste interne bot -> AyPi Backend.
AYPI_BOT_BACKEND_TIMEOUT_MS=10000

# Sicurezza: se allowed.json è vuoto o non raggiungibile, il bot resta chiuso.
# Abilitare soltanto consapevolmente per un bot pubblico.
AYPI_BOT_ALLOW_OPEN_ACCESS=0
