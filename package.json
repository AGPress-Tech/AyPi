{
  "name": "aypi",
  "version": "1.4.1",
  "description": "Software AyPi per gestione applicativi AGPress",
  "main": "dist-ts/main.js",
  "scripts": {
    "preview:forge": "node tools/preview-forge.cjs",
    "check:assets": "node tools/check-runtime-assets.cjs",
    "start:bluearchive": "npm run build:ts && electron . --bluearchive-preview",
    "import:spine-characters": "node tools\\import-spine-characters.js",
    "build:ts": "node tools\\build-ts.js",
    "build:backend": "npm run prepare:forno && npx tsc -p backend\\tsconfig.json",
    "build:backend:tray": "npx tsc -p tsconfig.backend-app.json",
    "dist:backend": "npm run build:backend && npm run build:backend:tray && npm run verify:backend:baseline && electron-builder --config electron-builder.backend.json",
    "dist:botbackend": "npm run dist:backend",
    "build": "npm run build:ts && electron-builder",
    "release": "npm run build:ts && electron-builder --publish always",
    "prepare:forno": "node tools\\prepare-forno-native.cjs",
    "test:forno": "node --test tools/test-forno.cjs tools/test-forno-multichannel.cjs tools/test-forno-startup.cjs tools/test-forno-analysis.cjs tools/test-forno-sample.cjs tools/test-forno-messages.cjs",
    "test:plc-engine": "node --test tools/test-plc-engine.cjs",
    "test:forno:view": "node --test tools/test-forno-preferences.cjs tools/test-forno-reveal.cjs tools/test-forno-average.cjs tools/test-forno-axes.cjs",
    "test:forno:transport": "node --test tools/test-forno-transport.cjs",
    "verify:backend:baseline": "node tools/verify-backend-baseline.cjs"
  },
  "author": "Ayrton Pizzi",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@network-utils/arp-lookup": "^2.1.0",
    "ajv": "^6.12.6",
    "axios": "^1.13.2",
    "better-sqlite3": "12.10.1",
    "bwip-js": "^4.8.0",
    "chart.js": "^4.5.1",
    "dotenv": "^16.6.1",
    "electron-log": "^5.3.1",
    "electron-updater": "^6.3.9",
    "hash-wasm": "^4.12.0",
    "koffi": "3.3.5",
    "nodemailer": "^7.0.12",
    "otplib": "^12.0.1",
    "protobufjs": "^8.8.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "telegraf": "^4.16.3",
    "three": "^0.186.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "asarUnpack": [
      "dist-ts/templates/plc-reader/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "appId": "com.Agpress.AyPi",
    "productName": "AyPi",
    "files": [
      "dist-ts/**/*",
      "package.json",
      "!**/*.ts",
      "!**/*.map",
      "!dist-backend/**/*",
      "!dist-backend-app/**/*",
      "!backend/**/*",
      "!backend-dist/**/*",
      "!src/**/*",
      "!docs/**/*",
      "!tools/**/*",
      "!.tmp-backend-test/**/*",
      "!cards_ts/**/*",
      "!types/**/*",
      "!*.log",
      "!tsconfig*.json",
      "!electron-builder.backend.json",
      "!**/*.py",
      "!**/__pycache__/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AGPress-Tech",
        "repo": "AyPi",
        "releaseType": "release",
        "private": false
      }
    ],
    "mac": {
      "icon": "assets/app-icon.icns"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": "nsis",
      "sign": false
    },
    "linux": {
      "icon": "assets/app-icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron@34.3.0": true,
    "esbuild@0.24.2": true,
    "better-sqlite3@12.10.1": true,
    "koffi@3.3.5": true
  }
}
